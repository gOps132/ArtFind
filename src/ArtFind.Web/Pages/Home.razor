@page "/"
@inject IArtistCatalogService CatalogService
@inject CommissionMatcher Matcher

<header class="bar">
    <div class="bar-in">
        <a href="/" class="brand" @onclick="ResetFilters" @onclick:preventDefault="true">ArtFind</a>

        <nav class="navrow" aria-label="Categories">
            <button type="button"
                    class="nav-pill @(string.IsNullOrEmpty(_selectedCategory) ? "on" : "")"
                    @onclick="() => _selectedCategory = string.Empty">
                All
            </button>
            @foreach (var item in AvailableCategories)
            {
                var isActive = _selectedCategory.Equals(item.Tag, StringComparison.OrdinalIgnoreCase);
                <button type="button"
                        class="nav-pill @(isActive ? "on" : "")"
                        @onclick="() => ToggleCategory(item.Tag)">
                    @FormatTag(item.Tag)<span class="n">@item.Count</span>
                </button>
            }
        </nav>

        <div class="search">
            <input type="search"
                   enterkeyhint="search"
                   aria-label="Commission Brief search"
                   placeholder="Search brief, style..."
                   @bind="_query"
                   @bind:event="oninput" />
            @if (HasActiveFilters)
            {
                <button type="button" class="search-clear" @onclick="ResetFilters" aria-label="Clear search and filters">✕</button>
            }
        </div>
    </div>

    <div class="filters" aria-label="Style tags and filters">
        <span class="lbl">Styles</span>
        @foreach (var item in AvailableStyles.Take(10))
        {
            var isActive = _selectedStyles.Contains(item.Tag);
            <button type="button"
                    class="chip @(isActive ? "on" : "")"
                    @onclick="() => ToggleStyle(item.Tag)">
                @FormatTag(item.Tag)<span class="n">@item.Count</span>
            </button>
        }

        @if (AvailableStyles.Count > 10)
        {
            <button type="button"
                    class="chip @(_showTagBrowser ? "on" : "")"
                    @onclick="() => _showTagBrowser = !_showTagBrowser">
                @(_showTagBrowser ? "Less" : $"+{TotalTagCount} tags")
            </button>
        }

        <span class="filter-sep" aria-hidden="true"></span>

        <select class="filter-select" @bind="_maxBudgetValue" aria-label="Filter by maximum budget">
            <option value="">Budget</option>
            <option value="30">≤ $30</option>
            <option value="60">≤ $60</option>
            <option value="120">≤ $120</option>
            <option value="250">≤ $250</option>
        </select>

        <select class="filter-select" @bind="_selectedPageType" aria-label="Filter by Artist Page platform">
            <option value="">Platform</option>
            <option value="VGen">VGen</option>
            <option value="Carrd">Carrd</option>
            <option value="Kofi">Ko-fi</option>
            <option value="Artistree">Artistree</option>
            <option value="Portfolio">Portfolio</option>
            <option value="Bluesky">Bluesky</option>
        </select>

        <label class="nsfw-toggle">
            <input type="checkbox" @bind="_includeNsfw" />
            <span>18+</span>
        </label>
    </div>

    @if (_showTagBrowser)
    {
        <div class="tag-browser-wrap">
            <div class="tag-browser" aria-label="Search all tags">
                <div class="tag-browser-header">
                    <input class="tag-search-input"
                           type="search"
                           placeholder="Filter all tags..."
                           @bind="_tagSearch"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_tagSearch))
                    {
                        <button type="button" class="btn btn-subtle" @onclick="() => _tagSearch = string.Empty">Clear</button>
                    }
                </div>

                @if (FilteredStyles.Count > 0)
                {
                    <div class="tag-group-label">Styles (@FilteredStyles.Count)</div>
                    <div class="tag-wrap">
                        @foreach (var item in FilteredStyles)
                        {
                            var isActive = _selectedStyles.Contains(item.Tag);
                            <button type="button"
                                    class="chip @(isActive ? "on" : "")"
                                    @onclick="() => ToggleStyle(item.Tag)">
                                @FormatTag(item.Tag)<span class="n">@item.Count</span>
                            </button>
                        }
                    </div>
                }

                @if (FilteredCategories.Count > 0)
                {
                    <div class="tag-group-label">Categories (@FilteredCategories.Count)</div>
                    <div class="tag-wrap">
                        @foreach (var item in FilteredCategories)
                        {
                            var isActive = _selectedCategory.Equals(item.Tag, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="chip @(isActive ? "on" : "")"
                                    @onclick="() => ToggleCategory(item.Tag)">
                                @FormatTag(item.Tag)<span class="n">@item.Count</span>
                            </button>
                        }
                    </div>
                }

                @if (FilteredStyles.Count == 0 && FilteredCategories.Count == 0)
                {
                    <p class="tag-empty">No tags match "@_tagSearch".</p>
                }
            </div>
        </div>
    }
</header>

<main class="container">
    <section class="hero">
        <h1 class="hero-title">
            Find an illustrator <em>open for work</em>
        </h1>
        <p class="hero-subtitle">
            Browse by category or style, then go directly to the Artist Page.
        </p>
    </section>

    @if (!_loading && _loadError is null)
    {
        <div class="results-bar">
            <span class="mono">@Matches.Count @(Matches.Count == 1 ? "artist" : "artists")</span>
        </div>
    }

    @if (_loading)
    {
        <section class="gallery-grid" aria-label="Loading artists">
            @for (var i = 0; i < 6; i++)
            {
                <div class="skeleton-card" aria-hidden="true">
                    <div class="skeleton-media"></div>
                    <div class="skeleton-line skeleton-line-lg"></div>
                    <div class="skeleton-line skeleton-line-sm"></div>
                    <div class="skeleton-line skeleton-line-md"></div>
                </div>
            }
        </section>
    }
    else if (_loadError is not null)
    {
        <div class="empty-state" role="alert">
            <h2 class="empty-title">Could not load artist directory</h2>
            <p class="empty-copy">@_loadError</p>
            <button type="button" class="btn btn-primary" @onclick="LoadCatalogAsync">Retry</button>
        </div>
    }
    else if (Matches.Count == 0)
    {
        <div class="empty-state">
            <h2 class="empty-title">No matching open artists</h2>
            <p class="empty-copy">
                Try broadening your Commission Brief or clearing one of the active filters.
            </p>
            <button type="button" class="btn btn-primary" @onclick="ResetFilters">Reset Filters</button>
        </div>
    }
    else
    {
        <section class="gallery-grid" aria-label="Matched Artists">
            @foreach (var match in Matches)
            {
                <ArtistCard @key="match.Artist.Id"
                            Match="match"
                            OnInspect="m => _inspectedMatch = m" />
            }
        </section>
    }
</main>

<footer class="footer">
    <div class="footer-inner">
        <span>ArtFind promotes public open-for-commission artists via Bluesky AT Protocol. No full-res artwork is re-hosted.</span>
        <span>
            Are you an artist? Add <code>#noartfind</code> to your bio or
            <button type="button" class="footer-link" @onclick="() => _showOptOut = true">opt out here</button>.
        </span>
    </div>
</footer>

<ArtistSheet Match="_inspectedMatch" OnClose="() => _inspectedMatch = null" />
<OptOutModal IsOpen="_showOptOut" OnClose="() => _showOptOut = false" OnSubmitted="HandleOptOutAsync" />

@code {
    private ArtistCatalogSnapshot? _snapshot;
    private bool _loading = true;
    private string _query = string.Empty;
    private string _selectedCategory = string.Empty;
    private string _maxBudgetValue = string.Empty;
    private string _selectedPageType = string.Empty;
    private bool _includeNsfw;
    private readonly HashSet<string> _selectedStyles = new(StringComparer.OrdinalIgnoreCase);

    private ArtistMatch? _inspectedMatch;
    private bool _showOptOut;
    private bool _showTagBrowser;
    private string _tagSearch = string.Empty;
    private string? _loadError;

    protected override Task OnInitializedAsync() => LoadCatalogAsync();

    private async Task LoadCatalogAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _snapshot = await CatalogService.LoadCatalogAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<(string Tag, int Count)> AvailableStyles =>
        (_snapshot?.Artists ?? [])
            .SelectMany(a => a.StyleTags)
            .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.Count()))
            .ToList();

    private IReadOnlyList<(string Tag, int Count)> AvailableCategories =>
        (_snapshot?.Artists ?? [])
            .SelectMany(a => a.CategoryTags)
            .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.Count()))
            .ToList();

    private int TotalTagCount => AvailableStyles.Count + AvailableCategories.Count;

    private IReadOnlyList<(string Tag, int Count)> FilteredStyles =>
        string.IsNullOrWhiteSpace(_tagSearch)
            ? AvailableStyles
            : AvailableStyles
                .Where(x => x.Tag.Contains(_tagSearch.Trim(), StringComparison.OrdinalIgnoreCase)
                         || FormatTag(x.Tag).Contains(_tagSearch.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToList();

    private IReadOnlyList<(string Tag, int Count)> FilteredCategories =>
        string.IsNullOrWhiteSpace(_tagSearch)
            ? AvailableCategories
            : AvailableCategories
                .Where(x => x.Tag.Contains(_tagSearch.Trim(), StringComparison.OrdinalIgnoreCase)
                         || FormatTag(x.Tag).Contains(_tagSearch.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToList();

    private void ToggleCategory(string category)
    {
        _selectedCategory = _selectedCategory.Equals(category, StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : category;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_query) ||
        _selectedStyles.Count > 0 ||
        !string.IsNullOrWhiteSpace(_selectedCategory) ||
        !string.IsNullOrWhiteSpace(_maxBudgetValue) ||
        !string.IsNullOrWhiteSpace(_selectedPageType) ||
        _includeNsfw;

    private IReadOnlyList<ArtistMatch> Matches
    {
        get
        {
            if (_snapshot is null) return [];

            var brief = new CommissionBrief
            {
                Query = _query,
                StyleTags = _selectedStyles.ToList(),
                CategoryTags = string.IsNullOrWhiteSpace(_selectedCategory) ? [] : [_selectedCategory],
                MaxBudgetUsd = int.TryParse(_maxBudgetValue, out var budget) ? budget : null,
                PreferredPageType = Enum.TryParse<ArtistPageType>(_selectedPageType, out var pt) ? pt : null,
                IncludeNsfw = _includeNsfw,
                OpenOnly = true
            };

            return Matcher.Match(_snapshot.Artists, brief);
        }
    }

    private void ToggleStyle(string style)
    {
        if (!_selectedStyles.Add(style))
            _selectedStyles.Remove(style);
    }

    private void ResetFilters()
    {
        _query = string.Empty;
        _selectedCategory = string.Empty;
        _maxBudgetValue = string.Empty;
        _selectedPageType = string.Empty;
        _includeNsfw = false;
        _selectedStyles.Clear();
    }

    private async Task HandleOptOutAsync((string Handle, string? Reason) request)
    {
        await CatalogService.SubmitOptOutAsync(request.Handle, request.Reason);
        _snapshot = await CatalogService.LoadCatalogAsync();
    }

    private static string FormatTag(string raw) =>
        string.Join(' ', raw.Split('-', StringSplitOptions.RemoveEmptyEntries)
            .Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
}
