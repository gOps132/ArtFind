@page "/"
@inject IArtistCatalogService CatalogService
@inject CommissionMatcher Matcher

<header class="topbar">
    <div class="topbar-inner">
        <div class="brand">
            <span class="brand-name">ArtFind</span>
            <span class="brand-divider" aria-hidden="true">/</span>
            <span class="brand-tag">Commission Directory</span>
        </div>

        <div class="topbar-actions">
            <span class="status-pill" title="Active data backend">
                <span class="status-dot" aria-hidden="true"></span>
                <span class="mono">@(CatalogService.IsUsingSupabase ? "LIVE · SUPABASE" : "SNAPSHOT · BLUESKY")</span>
            </span>
            <button type="button" class="btn btn-ghost" @onclick="() => _showOptOut = true">
                Artist Opt-Out
            </button>
        </div>
    </div>
</header>

<main class="container">
    <section class="hero-grid">
        <div class="hero">
            <div class="hero-eyebrow stagger-1">
                <span>Curated Visual Index</span>
                <span class="eyebrow-rule" aria-hidden="true"></span>
                <span class="mono">Direct to Artist Page</span>
            </div>
            <h1 class="hero-title stagger-2">
                Find an illustrator <em>open for work</em> right now.
            </h1>
            <p class="hero-subtitle stagger-3">
                Write a Commission Brief, narrow by style or budget, and go straight to the Artist’s own page—no middleman, no markup.
            </p>
        </div>

        <aside class="ledger-card stagger-3" aria-label="Directory summary">
            <div class="ledger-row">
                <span class="ledger-label">Open Artists</span>
                <span class="ledger-value mono">@(_loading ? "—" : (_snapshot?.Artists.Count ?? 0).ToString())</span>
            </div>
            <div class="ledger-row">
                <span class="ledger-label">Matched</span>
                <span class="ledger-value mono">@(_loading ? "—" : Matches.Count.ToString())</span>
            </div>
            <div class="ledger-row">
                <span class="ledger-label">Indexed</span>
                <span class="ledger-value mono">@(_snapshot is null ? "—" : _snapshot.GeneratedAt.ToLocalTime().ToString("MMM d · HH:mm"))</span>
            </div>
        </aside>
    </section>

    <section class="brief-panel stagger-4" aria-label="Commission Brief and Filters">
        <div class="brief-input-row">
            <div class="brief-input-wrap">
                <svg class="brief-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                </svg>
                <input class="brief-input"
                       type="search"
                       enterkeyhint="search"
                       placeholder="Describe your Commission Brief… e.g. painterly fantasy portrait, chibi emotes, pixel art"
                       @bind="_query"
                       @bind:event="oninput" />
            </div>

            @if (HasActiveFilters)
            {
                <button type="button" class="btn btn-ghost" @onclick="ResetFilters">
                    Clear
                </button>
            }
        </div>

        <div class="brief-controls">
            <select class="filter-select" @bind="_selectedCategory" aria-label="Filter by category">
                <option value="">All Categories</option>
                @foreach (var item in AvailableCategories)
                {
                    <option value="@item.Tag">@FormatTag(item.Tag) (@item.Count)</option>
                }
            </select>

            <select class="filter-select" @bind="_maxBudgetValue" aria-label="Filter by maximum budget">
                <option value="">Any Budget</option>
                <option value="30">Up to $30</option>
                <option value="60">Up to $60</option>
                <option value="120">Up to $120</option>
                <option value="250">Up to $250</option>
            </select>

            <select class="filter-select" @bind="_selectedPageType" aria-label="Filter by Artist Page platform">
                <option value="">Any Artist Page</option>
                <option value="VGen">VGen</option>
                <option value="Carrd">Carrd</option>
                <option value="Kofi">Ko-fi</option>
                <option value="Artistree">Artistree</option>
                <option value="Portfolio">Portfolio</option>
                <option value="Bluesky">Bluesky</option>
            </select>

            <label class="nsfw-toggle">
                <input type="checkbox" @bind="_includeNsfw" />
                <span>Include 18+ tagged</span>
            </label>
        </div>

        @if (AvailableStyles.Count > 0 || AvailableCategories.Count > 0)
        {
            <div class="chip-row" role="group" aria-label="Popular style tags">
                @foreach (var item in AvailableStyles.Take(8))
                {
                    var isActive = _selectedStyles.Contains(item.Tag);
                    <button type="button"
                            class="chip @(isActive ? "active" : "")"
                            @onclick="() => ToggleStyle(item.Tag)">
                        @FormatTag(item.Tag)<span class="chip-count">@item.Count</span>
                    </button>
                }

                <button type="button"
                        class="chip @(_showTagBrowser ? "active" : "")"
                        @onclick="() => _showTagBrowser = !_showTagBrowser">
                    @(_showTagBrowser ? "Hide Tag Search" : $"Search All Tags ({TotalTagCount})")
                </button>
            </div>
        }

        @if (_showTagBrowser)
        {
            <div class="tag-browser" aria-label="Search available tags">
                <div class="tag-browser-header">
                    <input class="tag-search-input"
                           type="search"
                           placeholder="Search available tags… e.g. anime, portrait, vtuber, chibi"
                           @bind="_tagSearch"
                           @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(_tagSearch))
                    {
                        <button type="button" class="btn btn-subtle" @onclick="() => _tagSearch = string.Empty">Clear</button>
                    }
                </div>

                @if (FilteredStyles.Count > 0)
                {
                    <div class="tag-group-label">Styles (@FilteredStyles.Count)</div>
                    <div class="chip-row" style="margin-top: 0;">
                        @foreach (var item in FilteredStyles)
                        {
                            var isActive = _selectedStyles.Contains(item.Tag);
                            <button type="button"
                                    class="chip @(isActive ? "active" : "")"
                                    @onclick="() => ToggleStyle(item.Tag)">
                                @FormatTag(item.Tag)<span class="chip-count">@item.Count</span>
                            </button>
                        }
                    </div>
                }

                @if (FilteredCategories.Count > 0)
                {
                    <div class="tag-group-label">Categories (@FilteredCategories.Count)</div>
                    <div class="chip-row" style="margin-top: 0;">
                        @foreach (var item in FilteredCategories)
                        {
                            var isActive = _selectedCategory.Equals(item.Tag, StringComparison.OrdinalIgnoreCase);
                            <button type="button"
                                    class="chip @(isActive ? "active" : "")"
                                    @onclick="() => ToggleCategory(item.Tag)">
                                @FormatTag(item.Tag)<span class="chip-count">@item.Count</span>
                            </button>
                        }
                    </div>
                }

                @if (FilteredStyles.Count == 0 && FilteredCategories.Count == 0)
                {
                    <p style="margin: 6px 0 0; font-size: 0.82rem; color: var(--ink-muted);">
                        No tags match "@_tagSearch". Try typing it directly into the Commission Brief box above to search artist bios.
                    </p>
                }
            </div>
        }
    </section>

    <div class="results-bar">
        <span>
            @if (_loading)
            {
                <text>Loading open artists…</text>
            }
            else
            {
                <strong>@Matches.Count</strong> <text>open @(Matches.Count == 1 ? "artist" : "artists") matched</text>
                @if (_snapshot is not null)
                {
                    <text> · indexed @_snapshot.GeneratedAt.ToLocalTime().ToString("MMM d, HH:mm")</text>
                }
            }
        </span>
        <span>Redirects directly to each Artist Page</span>
    </div>

    @if (_loading)
    {
        <div class="empty-state">
            <p style="margin: 0; color: var(--ink-muted);">Fetching open-for-commission artists…</p>
        </div>
    }
    else if (Matches.Count == 0)
    {
        <div class="empty-state">
            <h2 style="margin: 0 0 8px; font-family: 'Instrument Serif', Georgia, serif; font-size: 1.7rem; font-weight: 400;">
                No matching open artists right now
            </h2>
            <p style="margin: 0 0 16px; color: var(--ink-secondary); font-size: 0.9rem;">
                Try broadening your Commission Brief or clearing one of the filters.
            </p>
            <button type="button" class="btn btn-primary" @onclick="ResetFilters">Reset Filters</button>
        </div>
    }
    else
    {
        <section class="gallery-grid" aria-label="Matched Artists">
            @foreach (var match in Matches)
            {
                <ArtistCard @key="match.Artist.Id"
                            Match="match"
                            OnInspect="m => _inspectedMatch = m" />
            }
        </section>
    }
</main>

<footer class="footer">
    <div class="footer-inner">
        <span>ArtFind promotes public open-for-commission artists via Bluesky AT Protocol. No full-res artwork is re-hosted.</span>
        <span>Are you an artist? Add <code>#noartfind</code> to your bio or use Artist Opt-Out anytime.</span>
    </div>
</footer>

<ArtistSheet Match="_inspectedMatch" OnClose="() => _inspectedMatch = null" />
<OptOutModal IsOpen="_showOptOut" OnClose="() => _showOptOut = false" OnSubmitted="HandleOptOutAsync" />

@code {
    private ArtistCatalogSnapshot? _snapshot;
    private bool _loading = true;
    private string _query = string.Empty;
    private string _selectedCategory = string.Empty;
    private string _maxBudgetValue = string.Empty;
    private string _selectedPageType = string.Empty;
    private bool _includeNsfw;
    private readonly HashSet<string> _selectedStyles = new(StringComparer.OrdinalIgnoreCase);

    private ArtistMatch? _inspectedMatch;
    private bool _showOptOut;
    private bool _showTagBrowser;
    private string _tagSearch = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await CatalogService.LoadCatalogAsync();
        _loading = false;
    }

    private IReadOnlyList<(string Tag, int Count)> AvailableStyles =>
        (_snapshot?.Artists ?? [])
            .SelectMany(a => a.StyleTags)
            .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.Count()))
            .ToList();

    private IReadOnlyList<(string Tag, int Count)> AvailableCategories =>
        (_snapshot?.Artists ?? [])
            .SelectMany(a => a.CategoryTags)
            .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
            .OrderByDescending(g => g.Count())
            .ThenBy(g => g.Key)
            .Select(g => (g.Key, g.Count()))
            .ToList();

    private int TotalTagCount => AvailableStyles.Count + AvailableCategories.Count;

    private IReadOnlyList<(string Tag, int Count)> FilteredStyles =>
        string.IsNullOrWhiteSpace(_tagSearch)
            ? AvailableStyles
            : AvailableStyles
                .Where(x => x.Tag.Contains(_tagSearch.Trim(), StringComparison.OrdinalIgnoreCase)
                         || FormatTag(x.Tag).Contains(_tagSearch.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToList();

    private IReadOnlyList<(string Tag, int Count)> FilteredCategories =>
        string.IsNullOrWhiteSpace(_tagSearch)
            ? AvailableCategories
            : AvailableCategories
                .Where(x => x.Tag.Contains(_tagSearch.Trim(), StringComparison.OrdinalIgnoreCase)
                         || FormatTag(x.Tag).Contains(_tagSearch.Trim(), StringComparison.OrdinalIgnoreCase))
                .ToList();

    private void ToggleCategory(string category)
    {
        _selectedCategory = _selectedCategory.Equals(category, StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : category;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_query) ||
        _selectedStyles.Count > 0 ||
        !string.IsNullOrWhiteSpace(_selectedCategory) ||
        !string.IsNullOrWhiteSpace(_maxBudgetValue) ||
        !string.IsNullOrWhiteSpace(_selectedPageType) ||
        _includeNsfw;

    private IReadOnlyList<ArtistMatch> Matches
    {
        get
        {
            if (_snapshot is null) return [];

            var brief = new CommissionBrief
            {
                Query = _query,
                StyleTags = _selectedStyles.ToList(),
                CategoryTags = string.IsNullOrWhiteSpace(_selectedCategory) ? [] : [_selectedCategory],
                MaxBudgetUsd = int.TryParse(_maxBudgetValue, out var budget) ? budget : null,
                PreferredPageType = Enum.TryParse<ArtistPageType>(_selectedPageType, out var pt) ? pt : null,
                IncludeNsfw = _includeNsfw,
                OpenOnly = true
            };

            return Matcher.Match(_snapshot.Artists, brief);
        }
    }

    private void ToggleStyle(string style)
    {
        if (!_selectedStyles.Add(style))
            _selectedStyles.Remove(style);
    }

    private void ResetFilters()
    {
        _query = string.Empty;
        _selectedCategory = string.Empty;
        _maxBudgetValue = string.Empty;
        _selectedPageType = string.Empty;
        _includeNsfw = false;
        _selectedStyles.Clear();
    }

    private async Task HandleOptOutAsync((string Handle, string? Reason) request)
    {
        await CatalogService.SubmitOptOutAsync(request.Handle, request.Reason);
        _snapshot = await CatalogService.LoadCatalogAsync();
    }

    private static string FormatTag(string raw) =>
        string.Join(' ', raw.Split('-', StringSplitOptions.RemoveEmptyEntries)
            .Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
}
