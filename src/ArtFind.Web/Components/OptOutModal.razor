@if (IsOpen)
{
    <div class="modal-backdrop @(_closing ? "is-closing" : "")"
         @onclick="CloseAsync"
         @onkeydown="HandleKeyDown"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="Artist opt-out">
        <div class="modal-card @(_closing ? "is-closing" : "")" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">Artist Opt-Out</h2>
                <button type="button" class="btn btn-subtle btn-icon" @onclick="CloseAsync" aria-label="Close modal">✕</button>
            </div>

            <p class="modal-copy">
                ArtFind only links to public <strong>#commissionsopen</strong> artists and never re-hosts full-resolution artwork.
                If you prefer not to be listed, you can opt out two ways:
            </p>

            <ul class="modal-list">
                <li>Add <code>#noartfind</code> to your Bluesky bio (automatically honored on every sync).</li>
                <li>Or enter your Bluesky handle below to remove your listing immediately.</li>
            </ul>

            @if (_submitted)
            {
                <div class="modal-success">
                    <strong>Done.</strong> <code>@@@_handle.TrimStart('@')</code> has been added to the opt-out list and removed from results.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="CloseAndResetAsync">Close</button>
                </div>
            }
            else
            {
                <label class="field-label" for="optout-handle">Bluesky handle</label>
                <input id="optout-handle"
                       class="brief-input brief-input-boxed"
                       autocapitalize="none"
                       autocorrect="off"
                       placeholder="e.g. artist.bsky.social"
                       @bind="_handle" />

                <label class="field-label" for="optout-reason">Optional note</label>
                <input id="optout-reason"
                       class="brief-input brief-input-boxed"
                       placeholder="Optional reason"
                       @bind="_reason" />

                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" @onclick="CloseAsync">Cancel</button>
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(string.IsNullOrWhiteSpace(_handle) || _busy)"
                            @onclick="SubmitAsync">
                        @(_busy ? "Removing…" : "Remove My Listing")
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<(string Handle, string? Reason)> OnSubmitted { get; set; }

    private string _handle = string.Empty;
    private string _reason = string.Empty;
    private bool _busy;
    private bool _submitted;
    private bool _closing;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            _closing = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_handle)) return;
        _busy = true;
        await OnSubmitted.InvokeAsync((_handle, _reason));
        _busy = false;
        _submitted = true;
    }

    private async Task CloseAsync()
    {
        if (_closing) return;
        _closing = true;
        StateHasChanged();
        await Task.Delay(150);
        _closing = false;
        await OnClose.InvokeAsync();
    }

    private async Task CloseAndResetAsync()
    {
        await CloseAsync();
        _handle = string.Empty;
        _reason = string.Empty;
        _submitted = false;
    }

    private Task HandleKeyDown(KeyboardEventArgs e)
    {
        return e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
    }
}
