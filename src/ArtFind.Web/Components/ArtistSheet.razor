@if (Match is not null)
{
    var artist = Match.Artist;
    <div class="backdrop" @onclick="OnClose" role="dialog" aria-modal="true" aria-label="@artist.DisplayName details">
        <aside class="sheet" @onclick:stopPropagation="true">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
                <div class="artist-header">
                    @if (!string.IsNullOrWhiteSpace(artist.AvatarUrl))
                    {
                        <img class="avatar" style="width: 44px; height: 44px;" src="@artist.AvatarUrl" alt="" />
                    }
                    <div>
                        <h2 style="margin: 0; font-size: 1.2rem; font-weight: 600;">@artist.DisplayName</h2>
                        @if (artist.PrimarySource is not null)
                        {
                            <a class="artist-handle" href="@artist.PrimarySource.ProfileUrl" target="_blank" rel="noopener noreferrer">
                                @@@artist.PrimarySource.Handle on @artist.PrimarySource.Platform
                            </a>
                        }
                    </div>
                </div>
                <button type="button" class="btn btn-ghost" @onclick="OnClose" aria-label="Close preview">✕</button>
            </div>

            <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
                <span class="status-pill">
                    <span class="status-dot"></span>
                    Commissions Open
                </span>
                @if (artist.PriceRange is not null)
                {
                    <span class="price-badge">@artist.PriceRange.RawText</span>
                }
                <span class="tag-pill">Verified @artist.LastVerifiedAt.ToLocalTime().ToString("MMM d")</span>
            </div>

            @if (artist.Previews.Count > 0)
            {
                <div class="sheet-gallery">
                    @foreach (var preview in artist.Previews)
                    {
                        <a href="@(preview.SourcePostUrl ?? artist.ArtistPageUrl)" target="_blank" rel="noopener noreferrer">
                            <img src="@preview.ThumbnailUrl"
                                 alt="@(string.IsNullOrWhiteSpace(preview.AltText) ? artist.DisplayName : preview.AltText)" />
                        </a>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(artist.BioSnippet))
            {
                <p style="margin: 0; font-size: 0.92rem; color: var(--ink-secondary); white-space: pre-line;">@artist.BioSnippet</p>
            }

            @if (artist.StyleTags.Count > 0 || artist.CategoryTags.Count > 0)
            {
                <div class="tag-row">
                    @foreach (var tag in artist.StyleTags.Concat(artist.CategoryTags).Distinct())
                    {
                        <span class="tag-pill">@tag</span>
                    }
                </div>
            }

            <div style="margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 10px;">
                <a class="btn btn-accent"
                   style="padding: 12px 18px;"
                   href="@artist.ArtistPageUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    Open Artist Page (@artist.ArtistPageType) ↗
                </a>

                @if (artist.PrimarySource is not null)
                {
                    <a class="btn btn-ghost"
                       href="@(artist.PrimarySource.SourcePostUrl ?? artist.PrimarySource.ProfileUrl)"
                       target="_blank"
                       rel="noopener noreferrer">
                        View Original Post on Bluesky ↗
                    </a>
                }
            </div>
        </aside>
    </div>
}

@code {
    [Parameter] public ArtistMatch? Match { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
