@if (Match is not null)
{
    var artist = Match.Artist;
    var activePreview = artist.Previews.Count > 0
        ? artist.Previews[Math.Clamp(_selectedPreviewIndex, 0, artist.Previews.Count - 1)]
        : null;

    <div class="backdrop @(_closing ? "is-closing" : "")"
         @onclick="CloseAsync"
         @onkeydown="HandleKeyDown"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-label="@artist.DisplayName details">
        <aside class="sheet @(_closing ? "is-closing" : "")" @onclick:stopPropagation="true">
            <div class="sheet-top">
                <div class="artist-header">
                    @if (!string.IsNullOrWhiteSpace(artist.AvatarUrl))
                    {
                        <img class="avatar avatar-lg" src="@artist.AvatarUrl" alt="" />
                    }
                    <div class="artist-identity">
                        <h2 class="sheet-title">@artist.DisplayName</h2>
                        @if (artist.PrimarySource is not null)
                        {
                            <a class="artist-handle mono" href="@artist.PrimarySource.ProfileUrl" target="_blank" rel="noopener noreferrer">
                                @@@artist.PrimarySource.Handle · @artist.PrimarySource.Platform
                            </a>
                        }
                    </div>
                </div>
                <button type="button" class="btn btn-ghost btn-icon" @onclick="CloseAsync" aria-label="Close preview">✕</button>
            </div>

            <div class="sheet-meta">
                <span class="status-pill">
                    <span class="status-dot" aria-hidden="true"></span>
                    Commissions Open
                </span>
                @if (artist.PriceRange is not null)
                {
                    <span class="price-badge mono">@artist.PriceRange.RawText</span>
                }
                <span class="tag-pill mono">Verified @artist.LastVerifiedAt.ToLocalTime().ToString("MMM d")</span>
            </div>

            @if (activePreview is not null)
            {
                <a class="sheet-stage"
                   href="@(activePreview.SourcePostUrl ?? artist.ArtistPageUrl)"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Open original artwork post">
                    <img src="@activePreview.ThumbnailUrl"
                         alt="@(string.IsNullOrWhiteSpace(activePreview.AltText) ? artist.DisplayName : activePreview.AltText)" />
                </a>

                @if (artist.Previews.Count > 1)
                {
                    <div class="sheet-thumbs" role="group" aria-label="Artwork samples">
                        @for (var i = 0; i < artist.Previews.Count; i++)
                        {
                            var idx = i;
                            var preview = artist.Previews[idx];
                            <button type="button"
                                    class="sheet-thumb @(idx == _selectedPreviewIndex ? "active" : "")"
                                    @onclick="() => _selectedPreviewIndex = idx"
                                    aria-label="View sample @(idx + 1)">
                                <img src="@preview.ThumbnailUrl"
                                     alt="@(string.IsNullOrWhiteSpace(preview.AltText) ? $"{artist.DisplayName} sample {idx + 1}" : preview.AltText)" />
                            </button>
                        }
                    </div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(artist.BioSnippet))
            {
                <p class="sheet-bio">@artist.BioSnippet</p>
            }

            @if (artist.StyleTags.Count > 0 || artist.CategoryTags.Count > 0)
            {
                <div class="tag-row">
                    @foreach (var tag in artist.StyleTags.Concat(artist.CategoryTags).Distinct())
                    {
                        <span class="tag-pill">@tag</span>
                    }
                </div>
            }

            <div class="sheet-actions">
                <a class="btn btn-accent btn-lg"
                   href="@artist.ArtistPageUrl"
                   target="_blank"
                   rel="noopener noreferrer">
                    <span>Open Artist Page (@artist.ArtistPageType)</span>
                    <span aria-hidden="true">↗</span>
                </a>

                @if (artist.PrimarySource is not null)
                {
                    <a class="btn btn-ghost"
                       href="@(artist.PrimarySource.SourcePostUrl ?? artist.PrimarySource.ProfileUrl)"
                       target="_blank"
                       rel="noopener noreferrer">
                        <span>View Original Post on Bluesky</span>
                        <span aria-hidden="true">↗</span>
                    </a>
                }
            </div>
        </aside>
    </div>
}

@code {
    [Parameter] public ArtistMatch? Match { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int _selectedPreviewIndex;
    private string? _lastArtistId;
    private bool _closing;

    protected override void OnParametersSet()
    {
        var currentId = Match?.Artist.Id;
        if (currentId != _lastArtistId)
        {
            _lastArtistId = currentId;
            _selectedPreviewIndex = 0;
            _closing = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_closing) return;
        _closing = true;
        StateHasChanged();
        await Task.Delay(210);
        _closing = false;
        await OnClose.InvokeAsync();
    }

    private Task HandleKeyDown(KeyboardEventArgs e)
    {
        return e.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
    }
}
